[Unit]
Description=Comma DRM display broker
After=local-fs.target
Before=comma.service
Conflicts=weston.service weston-ready.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=comma
ExecStartPre=/bin/sleep 20
ExecStart=/usr/local/venv/bin/python -u /usr/comma/magic.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
