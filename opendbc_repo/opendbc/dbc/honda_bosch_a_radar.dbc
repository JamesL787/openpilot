VERSION "honda_bosch_a_radar -- 16-slot Bosch-A object bank (16 CAN-visible object slots, each a 4-frame main burst f0..f3 + one synchronized fine-angular companion frame). Hand-written (NOT generated by the opendbc generator pipeline). RANGE/AZIMUTH scaled companions are documentation-only; RadarInterface recomputes the physical values from RAW signals. f3 contains the two angular object bounds plus one matched edge-uncertainty magnitude; the companion frame contains the second matched edge-uncertainty magnitude and one still-unresolved auxiliary parameter. FRAME_IDX / LIFECYCLE_RAW are intentionally not named COUNTER."

NS_ :
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_TYPE_REF_
	VAL_TABLE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_
	BO_TX_BU_
	BA_DEF_REL_
	BA_REL_
	BA_DEF_DEF_REL_
	BU_SG_REL_
	BU_EV_REL_
	BU_BO_REL_
	SG_MUL_VAL_

BS_:

