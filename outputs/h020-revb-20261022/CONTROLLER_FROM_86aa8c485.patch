+def h020_version(car_fw):
+  versions = {bytes(f.fwVersion).split(b"\0", 1)[0] for f in car_fw if f.ecu == "eps"}
+  return next(iter(versions)) if len(versions) == 1 and versions <= PTM_VERSIONS else None
